        "jobs = [\n",
        "    {\"title\": \"AI Engineer\",     \"skills\": [\"Python\", \"AI\", \"ML\"],        \"location\": \"Delhi\",  \"salary\": 120000},\n",
        "    {\"title\": \"Python Dev\",      \"skills\": [\"Python\", \"Django\"],           \"location\": \"Mumbai\", \"salary\": 80000},\n",
        "    {\"title\": \"ML Engineer\",     \"skills\": [\"ML\", \"Python\"],               \"location\": \"Delhi\",  \"salary\": 95000},\n",
        "    {\"title\": \"Data Scientist\",  \"skills\": [\"ML\", \"Data Science\"],         \"location\": \"Pune\",   \"salary\": 110000},\n",
        "    {\"title\": \"Java Dev\",        \"skills\": [\"Java\", \"Spring\"],             \"location\": \"Pune\",   \"salary\": 75000},\n",
        "    {\"title\": \"Web Developer\",   \"skills\": [\"HTML\", \"CSS\", \"JavaScript\"],  \"location\": \"Mumbai\", \"salary\": 70000},\n",
        "    {\"title\": \"DevOps Engineer\", \"skills\": [\"Docker\", \"Kubernetes\", \"CI\"], \"location\": \"Delhi\",  \"salary\": 100000},\n",
        "]\n",
        "\n",
        "required_ai_skills = [\"Python\", \"AI\", \"ML\"]\n",
