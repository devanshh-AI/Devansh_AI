        "\n",
        "\n",
        "import datetime\n",
        "\n",
        "def get_user_input():\n",
        "    print(\"\\n\" + \"=\" * 45)\n",
        "    print(\"   📋 ENTER YOUR DETAILS\")\n",
        "    print(\"=\" * 45)\n",
        "\n",
        "    name       = input(\"  Your Name        : \")\n",
        "    location   = input(\"  Your Location    : \")\n",
        "    experience = int(input(\"  Experience (yrs) : \"))\n",
        "    salary     = int(input(\"  Expected Salary  : \"))\n",
        "\n",
        "    print(\"\\n  Enter skills (comma separated)\")\n",
        "    print(\"  Example: Python, AI, ML, Django\")\n",
        "    skills_input = input(\"  Your Skills      : \")\n",
        "    skills = [s.strip() for s in skills_input.split(\",\")]\n",
        "\n",
        "    candidate = {\n",
        "        \"name\":            name,\n",
        "        \"location\":        location,\n",
        "        \"experience\":      experience,\n",
        "        \"expected_salary\": salary,\n",
        "        \"skills\":          skills\n",
        "    }\n",
        "    return candidate\n",
        "\n",
        "\n",
        "\n",
        "def parse_resume(candidate):\n",
        "    print(\"\\n\" + \"=\" * 45)\n",
        "    print(\"   📄 YOUR RESUME ANALYSIS\")\n",
        "    print(\"=\" * 45)\n",
        "    print(f\"  Name        : {candidate['name']}\")\n",
        "    print(f\"  Location    : {candidate['location']}\")\n",
        "    print(f\"  Experience  : {candidate['experience']} years\")\n",
        "    print(f\"  Skills      : {', '.join(candidate['skills'])}\")\n",
        "    print(f\"  Exp. Salary : ₹{candidate['expected_salary']:,}\")\n",
        "\n",
        "    matched = 0\n",
        "    for skill in required_ai_skills:\n",
        "        if skill in candidate[\"skills\"]:\n",
        "            matched += 1\n",
        "\n",
        "    match_percent = (matched / len(required_ai_skills)) * 100\n",
        "    print(f\"\\n  AI Match    : {match_percent:.0f}%\")\n",
        "\n",
        "    if match_percent >= 80:\n",
        "        print(\"  Profile     : 🔥 Strong AI Candidate!\")\n",
        "    elif match_percent >= 50:\n",
        "        print(\"  Profile     : 👍 Good Candidate!\")\n",
        "    else:\n",
        "        print(\"  Profile     : ⚠️  Build More AI Skills!\")\n",
        "\n",
        "    return match_percent\n",
        "\n",
        "\n",
        "\n",
        "def match_jobs(candidate):\n",
        "    print(\"\\n\" + \"=\" * 45)\n",
        "    print(\"   🎯 BEST JOB MATCHES FOR YOU\")\n",
        "    print(\"=\" * 45)\n",
        "\n",
        "    results = []\n",
        "\n",
        "    for job in jobs:\n",
        "        job_skills = job[\"skills\"]\n",
        "        job_salary = job[\"salary\"]\n",
        "\n",
        "        matched = 0\n",
        "        for skill in job_skills:\n",
        "            if skill in candidate[\"skills\"]:\n",
        "                matched += 1\n",
        "\n",
        "        score = (matched / len(job_skills)) * 100\n",
        "\n",
        "        if job_salary >= candidate[\"expected_salary\"]:\n",
        "            salary_ok = \"✅\"\n",
        "        else:\n",
        "            salary_ok = \"❌\"\n",
        "\n",
        "        results.append({\n",
        "            \"title\":    job[\"title\"],\n",
        "            \"score\":    score,\n",
        "            \"salary\":   job_salary,\n",
        "            \"salary_ok\": salary_ok\n",
        "        })\n",
        "\n",
        "\n",
        "    results.sort(key=lambda x: x[\"score\"], reverse=True)\n",
        "\n",
        "\n",
        "    print(f\"\\n  {'Job Title':<20} {'Match':>6}  {'Salary':>10}  {'OK':>4}\")\n",
        "    print(\"  \" + \"-\" * 46)\n",
        "    for r in results[:3]:\n",
        "        print(f\"  {r['title']:<20} {r['score']:>5.0f}%  ₹{r['salary']:>9,}  {r['salary_ok']:>4}\")\n",
        "\n",
        "    best = results[0]\n",
        "    print(f\"\\n  🏆 Best Match → {best['title']} ({best['score']:.0f}% match)\")\n",
        "\n",
        "    return results\n",
        "\n",
        "def save_results(candidate, match_percent, results):\n",
        "    time_now = datetime.datetime.now().strftime(\"%Y-%m-%d %H:%M\")\n",
        "\n",
        "    with open(\"results.txt\", \"a\") as file:\n",
        "        file.write(\"\\n\" + \"=\" * 45 + \"\\n\")\n",
        "        file.write(f\"  Date     : {time_now}\\n\")\n",
        "        file.write(f\"  Name     : {candidate['name']}\\n\")\n",
        "        file.write(f\"  Skills   : {', '.join(candidate['skills'])}\\n\")\n",
        "        file.write(f\"  AI Match : {match_percent:.0f}%\\n\")\n",
        "        file.write(f\"\\n  Top Matches:\\n\")\n",
        "        for r in results[:3]:\n",
        "            file.write(f\"  → {r['title']:<20} {r['score']:.0f}% match\\n\")\n",
        "        file.write(\"=\" * 45 + \"\\n\")\n",
        "\n",
        "    print(f\"\\n  ✅ Results saved to results.txt!\")\n",
        "\n",
        "print(\"✅ All functions ready!\")\n",
        "\n",
        "def main():\n",
        "    print(\"\\n\" + \"=\" * 45)\n",
        "    print(\"   🤖 AI JOB MATCHER SYSTEM\")\n",
        "    print(\"   By Devansh | Delhi NCR AI Engineer\")\n",
        "    print(\"=\" * 45)\n",
        "\n",
        "    while True:\n",
        "        print(\"\\n  What do you want to do?\")\n",
        "        print(\"  1 → Find My Best Job Match\")\n",
        "        print(\"  2 → View Saved Results\")\n",
        "        print(\"  3 → Exit\")\n",
        "\n",
        "        choice = input(\"\\n  Enter choice (1/2/3): \")\n",
        "\n",
        "        if choice == \"1\":\n",
        "            candidate = get_user_input()       # Step 1 — input lo\n",
        "            match_pct = parse_resume(candidate) # Step 2 — resume analyze karo\n",
        "            results   = match_jobs(candidate)   # Step 3 — jobs match karo\n",
        "            save_results(candidate, match_pct, results) # Step 4 — save karo\n",
        "\n",
        "        elif choice == \"2\":\n",
        "            print(\"\\n\" + \"=\" * 45)\n",
        "            print(\"   📁 SAVED RESULTS\")\n",
        "            print(\"=\" * 45)\n",
        "            try:\n",
        "                with open(\"results.txt\", \"r\") as file:\n",
        "                    print(file.read())\n",
        "            except:\n",
        "                print(\"  No results saved yet!\")\n",
        "\n",
        "        elif choice == \"3\":\n",
        "            print(\"\\n  👋 All the best Devansh — AI Engineer bante raho!\")\n",
        "            print(\"=\" * 45 + \"\\n\")\n",
        "            break\n",
        "\n",
        "        else:\n",
        "            print(\"  ❌ Invalid — 1, 2 ya 3 enter karo!\")\n",
        "\n",
        "main()\n"
